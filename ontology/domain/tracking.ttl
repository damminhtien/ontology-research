@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix core: <https://damminhtien.github.io/ontology-research/ontology/core#> .
@prefix tracking: <https://damminhtien.github.io/ontology-research/ontology/domain/tracking#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://damminhtien.github.io/ontology-research/ontology/domain/tracking> a owl:Ontology ;
    dcterms:title "Domain Layer: Tracking"@en ;
    dcterms:description "Tracks correlate observations into hypotheses about entities. A Track is a derived information product (InformationObject), never an Event; see ADR-0005."@en ;
    dcterms:version "1.0.0" ;
    owl:imports <https://damminhtien.github.io/ontology-research/ontology/core> ;
    vann:preferredNamespacePrefix "tracking" ;
    vann:preferredNamespaceUri "https://damminhtien.github.io/ontology-research/ontology/domain/tracking#" .

#################################################################
# Classes
#################################################################

tracking:Track a owl:Class ; rdfs:subClassOf core:InformationObject ;
    rdfs:label "Track"@en ;
    rdfs:comment "Derived hypothesis correlating observations about one entity over time. Not an Event (ADR-0005)."@en .

tracking:ObservationResult a owl:Class ; rdfs:subClassOf core:InformationObject ;
    rdfs:label "Observation result"@en ;
    rdfs:comment "Position and typed measurements reported by one observation event. A result records sensor output and does not itself assert a world fact."@en .

tracking:Measurement a owl:Class ; rdfs:subClassOf core:InformationObject ;
    rdfs:label "Measurement"@en ;
    rdfs:comment "A measured value and optional unit in an observation result."@en .

tracking:EvidenceReference a owl:Class ; rdfs:subClassOf core:InformationObject ;
    rdfs:label "Evidence reference"@en ;
    rdfs:comment "An inline source-local locator or span attached to an observation result."@en .

#################################################################
# Properties
#################################################################

tracking:trackOf a owl:ObjectProperty ;
    rdfs:domain tracking:Track ; rdfs:range core:Entity ;
    rdfs:label "track of"@en ;
    rdfs:comment "The entity this track hypothesizes about (identity resolution result)."@en .

tracking:derivedFrom a owl:ObjectProperty ;
    rdfs:domain tracking:Track ; rdfs:range core:Observation ;
    rdfs:label "derived from"@en ;
    rdfs:comment "Observations contributing to this track."@en .

tracking:hasTrackId a owl:DatatypeProperty ;
    rdfs:domain tracking:Track ; rdfs:range <http://www.w3.org/2001/XMLSchema#string> ;
    rdfs:label "has track id"@en ;
    rdfs:comment "Stable identifier of the track within its tracking system."@en .

tracking:resultOf a owl:ObjectProperty ;
    rdfs:domain tracking:ObservationResult ; rdfs:range core:Observation ;
    rdfs:label "result of observation"@en ; core:assertable false .

tracking:position a owl:ObjectProperty ;
    rdfs:domain tracking:ObservationResult ; rdfs:range core:Location ;
    rdfs:label "measured position"@en ;
    rdfs:comment "Position reported by the sensor as part of this result, not a world assertion."@en ;
    core:assertable false .

tracking:measurement a owl:ObjectProperty ;
    rdfs:domain tracking:ObservationResult ; rdfs:range tracking:Measurement ;
    rdfs:label "measurement result"@en ; core:assertable false .

tracking:measurementName a owl:DatatypeProperty ;
    rdfs:domain tracking:Measurement ; rdfs:range xsd:string ;
    rdfs:label "measurement name"@en ; core:assertable false .

tracking:measurementValue a owl:DatatypeProperty ;
    rdfs:domain tracking:Measurement ; rdfs:range rdfs:Literal ;
    rdfs:label "measurement value"@en ; core:assertable false .

tracking:measurementUnit a owl:DatatypeProperty ;
    rdfs:domain tracking:Measurement ; rdfs:range xsd:string ;
    rdfs:label "measurement unit"@en ; core:assertable false .

tracking:evidence a owl:ObjectProperty ;
    rdfs:domain tracking:ObservationResult ; rdfs:range tracking:EvidenceReference ;
    rdfs:label "evidence reference"@en ; core:assertable false .

tracking:evidenceSource a owl:ObjectProperty ;
    rdfs:domain tracking:EvidenceReference ; rdfs:range core:Source ;
    rdfs:label "evidence source"@en ; core:assertable false .

tracking:locator a owl:DatatypeProperty ;
    rdfs:domain tracking:EvidenceReference ; rdfs:range xsd:string ;
    rdfs:label "source locator"@en ; core:assertable false .

tracking:spanStart a owl:DatatypeProperty ;
    rdfs:domain tracking:EvidenceReference ; rdfs:range xsd:integer ;
    rdfs:label "span start"@en ; core:assertable false .

tracking:spanEnd a owl:DatatypeProperty ;
    rdfs:domain tracking:EvidenceReference ; rdfs:range xsd:integer ;
    rdfs:label "span end"@en ; core:assertable false .

tracking:spanUnit a owl:DatatypeProperty ;
    rdfs:domain tracking:EvidenceReference ; rdfs:range xsd:string ;
    rdfs:label "span unit"@en ; core:assertable false .

