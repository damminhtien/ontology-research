@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix core: <https://damminhtien.github.io/ontology-research/ontology/core#> .

<https://damminhtien.github.io/ontology-research/ontology/core> a owl:Ontology ;
    dcterms:title "Semantic Core Kernel"@en ;
    dcterms:description "Semantic kernel: only stable, cross-domain classes and predicates. The hierarchy splits into disjoint branches — an information object (what we know: sources, statements) is never an event (what happened)."@en ;
    dcterms:version "1.0.0" ;
    vann:preferredNamespacePrefix "core" ;
    vann:preferredNamespaceUri "https://damminhtien.github.io/ontology-research/ontology/core#" .

#################################################################
# Classes (20) — Entity taxonomy, max depth kept shallow
#
#   Entity
#     ├── PhysicalObject ── Artifact ── {Platform, Facility}
#     ├── Agent ── {Person, Organization}
#     ├── System, Location, Role, Capability, Quality, State
#     ├── InformationObject ── {Source, LocationAssertion} ── (middle: assertion:Assertion)
#     └── Event ── {Activity, Observation}
#
# The two branches are disjoint by design: a statement is an information
# object, a happening is an event. Runtime events `AssertionMade` (creates an
# assertion) and `AssertionSuperseded` (affects one) are Events that mutate
# the information branch — nothing here is both.
#################################################################

core:Entity a owl:Class ; rdfs:label "Entity"@en ; rdfs:comment "Root of all things with identity."@en .

core:Agent a owl:Class ; rdfs:subClassOf core:Entity ; rdfs:label "Agent"@en .
core:Person a owl:Class ; rdfs:subClassOf core:Agent ; rdfs:label "Person"@en .
core:Organization a owl:Class ; rdfs:subClassOf core:Agent ; rdfs:label "Organization"@en .

core:PhysicalObject a owl:Class ; rdfs:subClassOf core:Entity ; rdfs:label "Physical Object"@en .
core:Artifact a owl:Class ; rdfs:subClassOf core:PhysicalObject ; rdfs:label "Artifact"@en .
core:Platform a owl:Class ; rdfs:subClassOf core:Artifact ; rdfs:label "Platform"@en .
core:Facility a owl:Class ; rdfs:subClassOf core:Artifact ; rdfs:label "Facility"@en .

core:System a owl:Class ; rdfs:subClassOf core:Entity ; rdfs:label "System"@en ;
    rdfs:comment "Engineered system of interacting components."@en .
core:InformationObject a owl:Class ; rdfs:subClassOf core:Entity ; rdfs:label "Information Object"@en ;
    rdfs:comment "A piece of information with identity — a source, a statement. Disjoint from core:Event: information is what we know, an event is what happened."@en ;
    owl:disjointWith core:Event .
core:Source a owl:Class ; rdfs:subClassOf core:InformationObject ; rdfs:label "Source"@en ;
    rdfs:comment "Provenance anchor for assertions and observations."@en .
core:Location a owl:Class ; rdfs:subClassOf core:Entity ; rdfs:label "Location"@en .

core:Event a owl:Class ; rdfs:subClassOf core:Entity ; rdfs:label "Event"@en ;
    rdfs:comment "Something that happens at a time. Events record change (an act of observing, an activity); the proposition itself lives in the information branch (core:InformationObject, e.g. assertion:Assertion)."@en .
core:Activity a owl:Class ; rdfs:subClassOf core:Event ; rdfs:label "Activity"@en .
core:Observation a owl:Class ; rdfs:subClassOf core:Event ; rdfs:label "Observation"@en ;
    rdfs:comment "An act of observing, anchored in time and to a source."@en .
core:LocationAssertion a owl:Class ; rdfs:subClassOf core:InformationObject ; rdfs:label "Location Assertion"@en ;
    rdfs:comment "Reified claim that an entity was located somewhere from some time — an informational statement, not an event. Written by the LocationObserved lane; the generic assertion:Assertion lane (ontology/middle/assertion.ttl) is the target model that lane migrates onto."@en .

core:Role a owl:Class ; rdfs:subClassOf core:Entity ; rdfs:label "Role"@en .
core:Capability a owl:Class ; rdfs:subClassOf core:Entity ; rdfs:label "Capability"@en .
core:Quality a owl:Class ; rdfs:subClassOf core:Entity ; rdfs:label "Quality"@en .
core:State a owl:Class ; rdfs:subClassOf core:Entity ; rdfs:label "State"@en .

#################################################################
# Object properties (24) — every property declares domain and range
#################################################################

core:partOf a owl:ObjectProperty ; rdfs:domain core:Entity ; rdfs:range core:Entity ;
    rdfs:label "part of"@en ; rdfs:comment "Transitive mereological/partonomic relation."@en .
core:hasPart a owl:ObjectProperty ; rdfs:domain core:Entity ; rdfs:range core:Entity ;
    owl:inverseOf core:partOf ; rdfs:label "has part"@en .
core:memberOf a owl:ObjectProperty ; rdfs:domain core:Agent ; rdfs:range core:Agent ;
    rdfs:label "member of"@en .
core:hasMember a owl:ObjectProperty ; rdfs:domain core:Agent ; rdfs:range core:Agent ;
    owl:inverseOf core:memberOf ; rdfs:label "has member"@en .

core:locatedAt a owl:ObjectProperty ; rdfs:domain core:Entity ; rdfs:range core:Location ;
    rdfs:label "located at"@en .
core:hasLocation a owl:ObjectProperty ; rdfs:domain core:Location ; rdfs:range core:Entity ;
    owl:inverseOf core:locatedAt ; rdfs:label "has located entity"@en .
core:currentLocation a owl:ObjectProperty ; rdfs:domain core:Entity ; rdfs:range core:Location ;
    rdfs:label "current location"@en ;
    rdfs:comment "OPERATIONAL PROJECTION ONLY — materialized by the read-model projector, never asserted directly by ingestion."@en .

core:participatesIn a owl:ObjectProperty ; rdfs:domain core:Entity ; rdfs:range core:Event ;
    rdfs:label "participates in"@en .
core:hasParticipant a owl:ObjectProperty ; rdfs:domain core:Event ; rdfs:range core:Entity ;
    owl:inverseOf core:participatesIn ; rdfs:label "has participant"@en .

core:operates a owl:ObjectProperty ; rdfs:domain core:Organization ; rdfs:range core:Artifact ;
    rdfs:label "operates"@en .
core:uses a owl:ObjectProperty ; rdfs:domain core:Agent ; rdfs:range core:Entity ;
    rdfs:label "uses"@en .
core:controls a owl:ObjectProperty ; rdfs:domain core:Agent ; rdfs:range core:Entity ;
    rdfs:label "controls"@en .
core:owns a owl:ObjectProperty ; rdfs:domain core:Agent ; rdfs:range core:Entity ;
    rdfs:label "owns"@en .

core:hasRole a owl:ObjectProperty ; rdfs:domain core:Agent ; rdfs:range core:Role ;
    rdfs:label "has role"@en ; rdfs:comment "Playing a role does NOT reclassify the agent."@en .
core:hasCapability a owl:ObjectProperty ; rdfs:domain core:Entity ; rdfs:range core:Capability ;
    rdfs:label "has capability"@en .

core:observes a owl:ObjectProperty ; rdfs:domain core:Observation ; rdfs:range core:Entity ;
    rdfs:label "observes"@en ; rdfs:comment "Subject is the observation act, not the observer."@en .
core:observedBy a owl:ObjectProperty ; rdfs:domain core:Entity ; rdfs:range core:Observation ;
    owl:inverseOf core:observes ; rdfs:label "observed by"@en .

core:produces a owl:ObjectProperty ; rdfs:domain core:Agent ; rdfs:range core:Entity ;
    rdfs:label "produces"@en .
core:consumes a owl:ObjectProperty ; rdfs:domain core:Agent ; rdfs:range core:Entity ;
    rdfs:label "consumes"@en .

core:dependsOn a owl:ObjectProperty ; rdfs:domain core:Entity ; rdfs:range core:Entity ;
    rdfs:label "depends on"@en .
core:connectedTo a owl:ObjectProperty ; rdfs:domain core:Entity ; rdfs:range core:Entity ;
    rdfs:label "connected to"@en ; rdfs:comment "Symmetric physical/logical connectivity."@en .

core:describes a owl:ObjectProperty ; rdfs:domain core:InformationObject ; rdfs:range core:Entity ;
    rdfs:label "describes"@en .
core:describedBy a owl:ObjectProperty ; rdfs:domain core:Entity ; rdfs:range core:InformationObject ;
    owl:inverseOf core:describes ; rdfs:label "described by"@en .
core:hasSource a owl:ObjectProperty ; rdfs:domain core:Entity ; rdfs:range core:Source ;
    rdfs:label "has source"@en ; rdfs:comment "Generic provenance link: any entity (an assertion, an observation, a derived product) cites the source(s) it came from. Deliberately domain-agnostic so both events and information objects can carry provenance; mapped to PROV-O prov:wasDerivedFrom in the middle layer instead of inventing a parallel vocabulary."@en .

#################################################################
# Datatype properties (9)
#################################################################

core:name a owl:DatatypeProperty ; rdfs:domain core:Entity ; rdfs:range xsd:string ;
    rdfs:label "name"@en .
core:alias a owl:DatatypeProperty ; rdfs:domain core:Entity ; rdfs:range xsd:string ;
    rdfs:label "alias"@en ; rdfs:comment "Alternative names used by identity resolution."@en .
core:externalId a owl:DatatypeProperty ; rdfs:domain core:Entity ; rdfs:range xsd:string ;
    rdfs:label "external id"@en .
core:atTime a owl:DatatypeProperty ; rdfs:domain core:Event ; rdfs:range xsd:dateTime ;
    rdfs:label "at time"@en ; rdfs:comment "Instant of an event/observation. Exactly one per observation."@en .
core:startTime a owl:DatatypeProperty ; rdfs:domain core:Event ; rdfs:range xsd:dateTime ;
    rdfs:label "start time"@en .
core:endTime a owl:DatatypeProperty ; rdfs:domain core:Event ; rdfs:range xsd:dateTime ;
    rdfs:label "end time"@en .
core:validFrom a owl:DatatypeProperty ; rdfs:domain core:InformationObject ; rdfs:range xsd:dateTime ;
    rdfs:label "valid from"@en ; rdfs:comment "Temporal validity start of an asserted fact. Domain is the information object (the statement), not the event that recorded it — an assertion stays valid after the assertion event happened."@en .
core:validUntil a owl:DatatypeProperty ; rdfs:domain core:InformationObject ; rdfs:range xsd:dateTime ;
    rdfs:label "valid until"@en .
core:hasConfidence a owl:DatatypeProperty ; rdfs:domain core:Entity ; rdfs:range xsd:decimal ;
    rdfs:label "has confidence"@en ; rdfs:comment "Assessed confidence in [0,1]. Constrained by SHACL. Carried by events (an observation act) and by derived information objects (an assertion), hence the domain-agnostic core:Entity."@en .
