@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix core: <https://damminhtien.github.io/ontology-research/ontology/core#> .
@prefix identity: <https://damminhtien.github.io/ontology-research/ontology/middle/identity#> .

<https://damminhtien.github.io/ontology-research/ontology/middle/identity> a owl:Ontology ;
    dcterms:title "Middle Layer: Identity references"@en ;
    dcterms:description "Identity references that have not resolved to a canonical world entity yet. They remain separate reference resources until an unambiguous identity event links them to a canonical projection."@en ;
    dcterms:version "1.0.0" ;
    owl:imports <https://damminhtien.github.io/ontology-research/ontology/core> ;
    vann:preferredNamespacePrefix "identity" ;
    vann:preferredNamespaceUri "https://damminhtien.github.io/ontology-research/ontology/middle/identity#" .

#################################################################
# Classes
#################################################################

identity:UnresolvedReference a owl:Class ; owl:disjointWith core:Entity ;
    rdfs:label "Unresolved reference"@en ;
    rdfs:comment "A source reference whose canonical world identity is not known. It is not a core:Entity and cannot satisfy a world-entity property range. The projector links assertions carrying the same reference ID only when one canonical identity is unambiguous."@en .

identity:Identifier a owl:Class ; rdfs:subClassOf core:InformationObject ;
    rdfs:label "Identifier"@en ;
    rdfs:comment "A first-class identifier value and issuing scheme that identifies one canonical entity."@en .

identity:referenceText a owl:DatatypeProperty ;
    rdfs:domain identity:UnresolvedReference ; rdfs:range <http://www.w3.org/2001/XMLSchema#string> ;
    rdfs:label "reference text"@en ;
    rdfs:comment "Surface form used by the source for an unresolved reference."@en .

identity:identifies a owl:ObjectProperty ;
    rdfs:domain identity:Identifier ; rdfs:range core:Entity ;
    rdfs:label "identifies"@en ; core:assertable false .

identity:identifierScheme a owl:DatatypeProperty ;
    rdfs:domain identity:Identifier ; rdfs:range <http://www.w3.org/2001/XMLSchema#string> ;
    rdfs:label "identifier scheme"@en ; core:assertable false .

identity:identifierValue a owl:DatatypeProperty ;
    rdfs:domain identity:Identifier ; rdfs:range <http://www.w3.org/2001/XMLSchema#string> ;
    rdfs:label "identifier value"@en ; core:assertable false .
