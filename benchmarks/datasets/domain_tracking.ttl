@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix core: <https://damminhtien.github.io/ontology-research/ontology/core#> .
@prefix location: <https://damminhtien.github.io/ontology-research/ontology/middle/location#> .
@prefix organization: <https://damminhtien.github.io/ontology-research/ontology/middle/organization#> .
@prefix sensor: <https://damminhtien.github.io/ontology-research/ontology/domain/sensor#> .
@prefix tracking: <https://damminhtien.github.io/ontology-research/ontology/domain/tracking#> .
@prefix ex: <https://data.example/entity/> .
@prefix src: <https://data.example/source/> .

# Phase 4 tracking vertical dataset. Extends sample_data.ttl by REUSING its
# IRIs (Cam Ranh, Coast Guard Region 4, patrol-01, obs-001, ...) so the whole
# vertical chain joins across both files. Benchmark scaffolding only — per
# ADR-0005 this file is never fed through the ingestion pipeline.

# ---- Administrative geography (types refine existing core:Location IRIs;
# names/partOf already live in sample_data.ttl — never restate them here) ----
ex:loc-vietnam a location:Country .
ex:loc-khanh-hoa a location:AdministrativeRegion .
ex:loc-cam-ranh a location:AdministrativeRegion .
ex:loc-vungtau a location:AdministrativeRegion .

# ---- Organization hierarchy -------------------------------------------------
ex:org-cg-region4 organization:subordinateTo ex:org-maritime-hq .

# ---- Sensors ----------------------------------------------------------------
ex:radar-01 a sensor:Sensor ;
    core:name "Surface Search Radar" ;
    sensor:mountedOn ex:patrol-01 .

# Physical detection links (complement core:hasSource provenance)
ex:obs-001 sensor:detectedBy ex:radar-01 .
ex:result-001 a tracking:ObservationResult ;
    tracking:resultOf ex:obs-001 ;
    tracking:position ex:loc-cam-ranh ;
    tracking:measurement [
        tracking:measurementName "speed" ;
        tracking:measurementValue "12.4"^^xsd:decimal ;
        tracking:measurementUnit "kn"
    ] ;
    core:hasConfidence "0.92"^^xsd:decimal .

ex:result-002 a tracking:ObservationResult ;
    tracking:resultOf ex:obs-002 ;
    tracking:position ex:loc-hanoi ;
    tracking:measurement [
        tracking:measurementName "quality" ;
        tracking:measurementValue "0.85"^^xsd:decimal
    ] ;
    core:hasConfidence "0.85"^^xsd:decimal .

ex:obs-003 a core:Observation ;
    core:observes ex:patrol-01 ;
    core:atTime "2026-08-20T05:15:00Z"^^xsd:dateTime ;
    core:hasSource src:ais-feed ;
    sensor:detectedBy ex:radar-01 .
ex:result-003 a tracking:ObservationResult ;
    tracking:resultOf ex:obs-003 ;
    tracking:position ex:loc-vungtau ;
    tracking:measurement [
        tracking:measurementName "heading" ;
        tracking:measurementValue "184.5"^^xsd:decimal;
        tracking:measurementUnit "degree"
    ] ;
    core:hasConfidence "0.90"^^xsd:decimal .

# ---- Track (derived information product, ADR-0005) ---------------------------
ex:track-t101 a tracking:Track ;
    core:name "Track T-101" ;
    tracking:hasTrackId "T-101" ;
    tracking:trackOf ex:patrol-01 ;
    tracking:derivedFrom ex:obs-001 , ex:obs-003 .
