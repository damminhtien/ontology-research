# CQ-013 (Q3): Which organizations are transitively subordinate to Maritime HQ?
PREFIX core: <https://damminhtien.github.io/ontology-research/ontology/core#>
PREFIX organization: <https://damminhtien.github.io/ontology-research/ontology/middle/organization#>

SELECT DISTINCT ?name WHERE {
  ?org organization:subordinateTo+ <https://data.example/entity/org-maritime-hq> ;
       core:name ?name .
}
ORDER BY ?name
