# CQ-010 (Q5 Provenance): which sources support the fact
# "patrol-01 was located at Cam Ranh Bay"? Target p95 < 500ms.
PREFIX core: <https://damminhtien.github.io/ontology-research/ontology/core#>
PREFIX assertion: <https://damminhtien.github.io/ontology-research/ontology/middle/assertion#>
PREFIX ex: <https://data.example/entity/>

SELECT ?sourceLabel WHERE {
  ?la a assertion:Assertion ;
      core:describes ex:patrol-01 ;
      assertion:predicate core:locatedAt ;
      assertion:hasObject ex:loc-cam-ranh ;
      core:hasSource ?s .
  ?s core:name ?sourceLabel .
}
ORDER BY ?sourceLabel
