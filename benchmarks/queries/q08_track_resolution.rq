# CQ-014 (Q2): Which real-world entity does track T-101 resolve to?
# Identity: the track-of link is the ER system's hypothesis (ADR-0003).
PREFIX core: <https://ontology.example/core#>
PREFIX tracking: <https://ontology.example/domain/tracking#>

SELECT ?trackId ?entityName WHERE {
  ?track tracking:hasTrackId ?trackId ;
         tracking:trackOf ?entity .
  ?entity core:name ?entityName .
  FILTER(?trackId = "T-101")
}
ORDER BY ?trackId
