# CQ-015 (Q3): Tracks whose tracked entity is operated by an organization
# located inside region Khanh Hoa (transitive core:partOf* containment).
# Full vertical: Track -> Entity <- operates <- Org -> locatedAt -> partOf* -> Region.
PREFIX core: <https://ontology.example/core#>
PREFIX tracking: <https://ontology.example/domain/tracking#>

SELECT DISTINCT ?trackId ?platformName ?orgName WHERE {
  ?track tracking:hasTrackId ?trackId ;
         tracking:trackOf ?platform .
  ?org core:operates ?platform ;
       core:name ?orgName ;
       core:locatedAt ?loc .
  ?loc core:partOf* <https://data.example/entity/loc-khanh-hoa> .
  ?platform core:name ?platformName .
}
ORDER BY ?trackId
