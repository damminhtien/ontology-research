# CQ-008 (Q4 Temporal as-of): where was patrol-01 at cutoff time?
# Location assertion valid at the requested instant.
# The query reads generic assertion history with its half-open valid interval.
# Target p95 < 500ms.
PREFIX core: <https://damminhtien.github.io/ontology-research/ontology/core#>
PREFIX assertion: <https://damminhtien.github.io/ontology-research/ontology/middle/assertion#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX ex: <https://data.example/entity/>

SELECT ?placeName ?t WHERE {
  ?la a assertion:Assertion ;
      core:describes ex:patrol-01 ;
      assertion:predicate core:locatedAt ;
      assertion:hasObject ?loc ;
      core:validFrom ?t .
  FILTER(?t <= "2026-08-21T00:00:00Z"^^xsd:dateTime)
  FILTER NOT EXISTS { ?la core:validUntil ?until . FILTER(?until <= "2026-08-21T00:00:00Z"^^xsd:dateTime) }
  ?loc core:name ?placeName .
}
ORDER BY ?t
