@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix core: <https://damminhtien.github.io/ontology-research/ontology/core#> .
@prefix identity: <https://damminhtien.github.io/ontology-research/ontology/middle/identity#> .

# A placeholder for a referenced-but-not-yet-minted entity must carry exactly
# one name: that surface form is what the projector uses to link observations
# to the entity once identity resolves (architecture §4.7).
identity:UnresolvedReferenceShape a sh:NodeShape ;
    sh:targetClass identity:UnresolvedReference ;
    sh:property [
        sh:path core:name ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "Unresolved reference must carry exactly one core:name (the cited surface form)."@en ;
    ] .
