@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix core: <https://damminhtien.github.io/ontology-research/ontology/core#> .
@prefix sensor: <https://damminhtien.github.io/ontology-research/ontology/domain/sensor#> .
@prefix tracking: <https://damminhtien.github.io/ontology-research/ontology/domain/tracking#> .

# A Track is a derived information product: it MUST resolve to exactly one
# entity, cite at least one supporting observation, and carry exactly one
# string identifier (ADR-0005).
tracking:TrackShape a sh:NodeShape ;
    sh:targetClass tracking:Track ;
    sh:property [
        sh:path tracking:trackOf ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:class core:Entity ;
        sh:message "Track must resolve to exactly one Entity via trackOf."@en ;
    ] ;
    sh:property [
        sh:path tracking:derivedFrom ;
        sh:minCount 1 ;
        sh:class core:Observation ;
        sh:message "Track must derive from at least one Observation."@en ;
    ] ;
    sh:property [
        sh:path tracking:hasTrackId ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "Track must carry exactly one xsd:string track id."@en ;
    ] .

tracking:ObservationResultShape a sh:NodeShape ;
    sh:targetClass tracking:ObservationResult ;
    sh:property [
        sh:path tracking:resultOf ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:class core:Observation ;
        sh:message "ObservationResult must belong to exactly one observation event."@en ;
    ] ;
    sh:property [
        sh:path tracking:position ;
        sh:maxCount 1 ;
        sh:class core:Location ;
        sh:message "ObservationResult may report at most one measured position."@en ;
    ] ;
    sh:property [
        sh:path tracking:measurement ;
        sh:node [
            sh:property [
                sh:path tracking:measurementName ;
                sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
            ] ;
            sh:property [
                sh:path tracking:measurementValue ;
                sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:Literal ;
            ] ;
            sh:property [
                sh:path tracking:measurementUnit ;
                sh:maxCount 1 ; sh:datatype xsd:string ;
            ] ;
        ] ;
    ] ;
    sh:property [
        sh:path core:hasConfidence ;
        sh:maxCount 1 ; sh:datatype xsd:decimal ;
        sh:minInclusive 0 ; sh:maxInclusive 1 ;
    ] ;
    sh:property [
        sh:path tracking:evidence ;
        sh:node [
            sh:property [
                sh:path tracking:evidenceSource ; sh:minCount 1 ; sh:maxCount 1 ;
                sh:class core:Source ;
            ] ;
            sh:property [ sh:path tracking:locator ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
            sh:property [ sh:path tracking:spanStart ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
            sh:property [ sh:path tracking:spanEnd ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
            sh:property [ sh:path tracking:spanUnit ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
        ] ;
    ] ;
    sh:or (
        [ sh:property [ sh:path tracking:position ; sh:minCount 1 ] ]
        [ sh:property [ sh:path tracking:measurement ; sh:minCount 1 ] ]
    ) .

# A Sensor MUST be mounted on exactly one platform — an unmounted sensor
# reading is not a meaningful operational fact.
sensor:SensorShape a sh:NodeShape ;
    sh:targetClass sensor:Sensor ;
    sh:property [
        sh:path sensor:mountedOn ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:class core:Platform ;
        sh:message "Sensor must be mounted on exactly one Platform."@en ;
    ] .
