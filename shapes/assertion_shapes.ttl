# SHACL shapes for the Document → Assertion model (docs/architecture.md §4.2).
#
# The assertion layer is the target model new fact types build on: one reified
# statement = a resolved subject (core:describes) or pending reference,
# relation named by IRI
# (assertion:predicate), typed object (assertion:hasObject for entities and
# locations, assertion:literalValue for literals), valid time (core:validFrom,
# core:validUntil), provenance (core:hasSource → core:Source) and
# optional confidence. Corrections are replacement assertions linked by
# assertion:supersedes; AssertionSuperseded events represent retractions with
# no replacement. Neither operation rewrites history (ADR-0002). Property
# counts mirror the write-path validation in
# foundry/assertions.py.
#
# assertion:predicate is constrained as an IRI. The write path validates the
# predicate against declared, assertable properties before accepting an event.

@prefix sh:        <http://www.w3.org/ns/shacl#> .
@prefix xsd:       <http://www.w3.org/2001/XMLSchema#> .
@prefix core:      <https://damminhtien.github.io/ontology-research/ontology/core#> .
@prefix assertion: <https://damminhtien.github.io/ontology-research/ontology/middle/assertion#> .
@prefix identity:  <https://damminhtien.github.io/ontology-research/ontology/middle/identity#> .

assertion:AssertionShape a sh:NodeShape ;
    sh:targetClass assertion:Assertion ;
    sh:xone (
        [ sh:property [
            sh:path core:describes ; sh:minCount 1 ; sh:maxCount 1 ;
            sh:class core:Entity ;
        ] ]
        [ sh:property [
            sh:path assertion:subjectReference ; sh:minCount 1 ; sh:maxCount 1 ;
            sh:class identity:UnresolvedReference ;
        ] ]
    ) ;
    sh:property [
        sh:path assertion:predicate ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "Assertion must name exactly one relation IRI."@en ;
    ] ;
    sh:property [
        sh:path assertion:hasObject ;
        sh:maxCount 1 ;
        sh:class core:Entity ;
        sh:message "Assertion may point at at most one object entity/location."@en ;
    ] ;
    # The literal object is typed per value (xsd:decimal, xsd:integer, plain
    # string, language tag), so the shape constrains it to a literal rather
    # than to one datatype. "datatype XOR language tag, default xsd:string" is
    # a syntax rule enforced once in the write path (foundry/assertions.py).
    sh:property [
        sh:path assertion:literalValue ;
        sh:maxCount 1 ;
        sh:nodeKind sh:Literal ;
        sh:message "Assertion may carry at most one literal object."@en ;
    ] ;
    # Exactly one object representation: hasObject XOR literalValue — never
    # both, never neither (foundry/assertions.py takes a single object_kind).
    sh:xone (
        [ sh:property [ sh:path assertion:hasObject ; sh:minCount 1 ] ]
        [ sh:property [ sh:path assertion:literalValue ; sh:minCount 1 ] ]
    ) ;
    sh:property [
        sh:path core:validFrom ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:dateTime ;
        sh:message "Assertion must have exactly one xsd:dateTime validFrom."@en ;
    ] ;
    sh:property [
        sh:path core:validUntil ;
        sh:maxCount 1 ;
        sh:datatype xsd:dateTime ;
        sh:message "Assertion may have at most one validUntil."@en ;
    ] ;
    sh:sparql [
        sh:message "validUntil is exclusive and must be later than validFrom."@en ;
        sh:select """
            PREFIX core: <https://damminhtien.github.io/ontology-research/ontology/core#>
            SELECT $this WHERE {
                $this core:validFrom ?from ; core:validUntil ?until .
                FILTER (?until <= ?from)
            }
        """ ;
    ] ;
    sh:property [
        sh:path core:hasSource ;
        sh:minCount 1 ;
        sh:class core:Source ;
        sh:message "Assertion must cite at least one Source."@en ;
    ] ;
    sh:property [
        sh:path assertion:evidence ;
        sh:node [
            sh:property [
                sh:path assertion:evidenceSource ; sh:minCount 1 ; sh:maxCount 1 ;
                sh:class core:Source ;
            ] ;
            sh:property [ sh:path assertion:locator ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
            sh:property [ sh:path assertion:spanStart ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
            sh:property [ sh:path assertion:spanEnd ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
            sh:property [ sh:path assertion:spanUnit ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
        ] ;
    ] ;
    sh:property [
        sh:path core:hasConfidence ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0 ; sh:maxInclusive 1 ;
        sh:message "Confidence must be a decimal in [0,1]."@en ;
    ] ;
    sh:property [
        sh:path assertion:supersedes ;
        sh:maxCount 1 ;
        sh:class assertion:Assertion ;
        sh:message "Assertion may supersede at most one other Assertion."@en ;
    ] .

# A provenance source is a core:Source with a human-readable name. Documents
# remain a subtype; sensor feeds and registries use the same range.
assertion:DocumentShape a sh:NodeShape ;
    sh:targetClass assertion:Document ;
    sh:property [
        sh:path core:name ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "Document needs at least one name."@en ;
    ] .
